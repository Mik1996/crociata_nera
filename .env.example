# Copy this file to .env and fill in your values. The .env file must NOT be committed.

# Token from https://developer.clashofclans.com (the key must allow the server's public IP)
COC_API_TOKEN=

# Tag of the clan to monitor (quoted: in .env the # character starts a comment)
COC_CLAN_TAG="#2J8JVVCLC"

# Proxy port (must match "target" in proxy.conf.json)
PORT=3000

# How often, in minutes, to poll the current war to archive it (0 = disabled)
COC_POLL_MINUTES=15

# Path of the war archive file (default: server/data/wars.json)
# COC_ARCHIVE_FILE=

# Folder of the monthly history files (default: server/data/history/)
# COC_HISTORY_DIR=
