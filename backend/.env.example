# Copy to `.env.local` and fill in. Never commit real values.

# MongoDB connection string (local or Atlas)
DATABASE_URL=mongodb://localhost:27017/crociata-nera

# HMAC secret for access tokens: at least 32 random characters
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=

# Lifetimes: number + unit (s, m, h, d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Origins allowed to call the API (comma-separated)
FRONTEND_URL=http://localhost:4200

# Optional: accept wars of this clan only
CLAN_TAG=#2J8JVVCLC
