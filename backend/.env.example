# Copy to `.env.local` and fill in. Never commit real values.

# MongoDB connection string (local or Atlas)
DATABASE_URL=mongodb://localhost:27017/crociata-nera

# HMAC secret for access tokens: at least 32 random characters
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=

# Lifetimes: number + unit (s, m, h, d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Origins allowed to call the API (comma-separated; the first one is used in e-mail links).
# :4400 is `npm run start:prod` (production build with the service worker).
FRONTEND_URL=http://localhost:4200,http://localhost:4400

# Clan whose wars are read and saved (with the #)
# In quotes: an unquoted "#" starts a comment and the value would be empty.
CLAN_TAG="#2J8JVVCLC"

# --- Automatic war sync -------------------------------------------------------
# Clash of Clans API key, created on https://developer.clashofclans.com for the
# PUBLIC IP of the machine running this backend. Paste it here, in `.env.local`.
COC_API_TOKEN=

# Minutes between two reads of the current war (0 = built-in scheduler off)
WAR_SYNC_INTERVAL_MINUTES=10

# Optional: enables POST /api/v1/cron/war-sync for external schedulers (≥ 32 characters)
CRON_SECRET=

# --- Accounts -----------------------------------------------------------------
# Public URL used in email links (default: the first FRONTEND_URL)
# APP_URL=http://localhost:4200

# Emails that get the ADMIN role at sign-up / sign-in (comma-separated)
ADMIN_EMAILS=

# Outgoing email (password reset, email confirmation). Without SMTP, in development the
# messages (with their links) are printed in the backend console instead.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Crociata Nera <no-reply@crociatanera.it>
