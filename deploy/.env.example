# Production settings. On the VPS: cp .env.example .env, fill in, keep it private.
# This file (.env) is never committed and never leaves the server.

# Public domain (without www: www redirects here)
DOMAIN=crociatanera.it

# Clan to follow (keep the quotes: # would start a comment)
CLAN_TAG="#2J8JVVCLC"

# Clash of Clans API key created for the VPS IP on developer.clashofclans.com
COC_API_TOKEN=

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.../crociata-nera?...)
# Wrap it in single quotes if it contains special characters.
DATABASE_URL=

# Secret for login tokens: generate it ON THE SERVER with
#   openssl rand -base64 48
JWT_SECRET=

# Optional tuning
# WAR_SYNC_INTERVAL_MINUTES=10
# COC_POLL_MINUTES=15
