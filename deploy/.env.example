# Production settings. On the VPS: cp .env.example .env, fill in, keep it private.
# This file (.env) is never committed and never leaves the server.

# Public domain (without www: www redirects here)
DOMAIN=crociatanera.it

# Clan to follow (keep the quotes: # would start a comment)
CLAN_TAG="#2J8JVVCLC"

# Clash of Clans API key created for the VPS IP on developer.clashofclans.com
COC_API_TOKEN=

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.../crociata-nera?...)
# Wrap it in single quotes if it contains special characters.
DATABASE_URL=

# Secret for login tokens: generate it ON THE SERVER with
#   openssl rand -base64 48
JWT_SECRET=

# Administrators: these emails get the ADMIN role when they sign up / sign in (comma-separated)
ADMIN_EMAILS=

# Outgoing email for password reset and email confirmation (any SMTP provider, e.g. Brevo).
# Without these, everything works except that emails are not sent.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM='Crociata Nera <no-reply@crociatanera.it>'

# Telegram bot that posts the bases of the arsenal in the clan's channels (see README "Telegram").
# Without the token, Telegram is off and the site works as before.
# Token from @BotFather (the production bot, not the dev one):
# TELEGRAM_BOT_TOKEN=
# Secret Telegram sends with every update; generate it ON THE SERVER with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# Optional tuning
# WAR_SYNC_INTERVAL_MINUTES=10

# Emergency: 1 switches the service worker (offline cache) off in the browsers, deploy after deploy,
# until set back to 0 (see README "Service worker"; for an immediate stop: ./service-worker.sh off).
# SW_DISABLED=0

# Backup (deploy/backup.sh, see README "Backup"), all optional:
# BACKUP_DIR=/root/backups
# KEEP_DAYS=14
# Smaller dumps are an error (an empty database gives ~150 bytes): about half of a usual dump.
# BACKUP_MIN_BYTES=4096
# Offsite copy with rclone to an ENCRYPTED (crypt) remote, kept there BACKUP_RCLONE_KEEP_DAYS days.
# BACKUP_RCLONE_REMOTE=crociata-crypt:
# BACKUP_RCLONE_KEEP_DAYS=60
# Dead man's switch: pinged after each good backup, <url>/fail after a failed one.
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
