# Public entry point: HTTPS certificates (Let's Encrypt) are obtained and renewed by Caddy.
# DOMAIN comes from deploy/.env (e.g. crociatanera.it).

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Clash of Clans proxy (server/)
	handle /api/coc/* {
		reverse_proxy proxy:3000
	}

	# Application backend (backend/): auth, saved wars, defense bases.
	# Largest request: a base screenshot (10 MB, checked again by the backend) plus its form fields.
	handle /api/v1/* {
		request_body {
			max_size 11MB
		}
		reverse_proxy backend:3001
	}

	# Angular app. Hashed bundles (main-AB12CD34.js) never change: cached for a year.
	# Everything else, including index.html served for deep links such as /players, is
	# revalidated on every visit, so a new deploy shows up at once.
	handle {
		root * /srv
		@hashed path_regexp \.[0-9a-zA-Z]{8,}\.(js|css)$
		@other not path_regexp \.[0-9a-zA-Z]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
