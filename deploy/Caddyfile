# Public entry point: HTTPS certificates (Let's Encrypt) are obtained and renewed by Caddy.
# DOMAIN comes from deploy/.env (e.g. crociatanera.it).

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Access log, one JSON line per request on stdout: Docker keeps and rotates it with the container's
	# logs (docker-compose.yml), `docker compose logs web` shows it. Caddy redacts cookies and the
	# Authorization header.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Other sites' pages cannot load the site's files (images of the bases, scripts). Telegram and link
		# previews download them from their servers, which this header does not concern. No
		# Cross-Origin-Embedder-Policy: Google Fonts and the Clash of Clans images do not opt in to it.
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}

	# Content-Security-Policy is in Report-Only mode: browsers report violations in the console
	# (DevTools) and block nothing. README "Content Security Policy" explains how to enforce it.
	# Two policies, both set at this level: a `header` inside `handle /api/v1/*` would be overwritten
	# by one set here (a header block that deletes a header, like the one above, is applied last).
	#
	# The app: the two script hashes are the inline scripts of the built index.html, the theme
	# script of src/index.html (KEEP IN SYNC: any change to it, even whitespace, changes its hash)
	# and the one Angular's build adds to load the styles without blocking the page (changes only
	# with Angular). Recompute them from dist/crociata_nera/browser/index.html (see the README).
	@not_docs not path /api/v1/docs
	header @not_docs Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-sM2lxRb7I6NiqTZOiV6naujZdoP+QMJelf0qs7NM3co=' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://api-assets.clashofclans.com; connect-src 'self' blob: https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	# Swagger UI (backend/src/app/api/v1/docs/route.ts): files from cdn.jsdelivr.net and an inline
	# script whose hash is KEPT IN SYNC with the PAGE of route.ts.
	header /api/v1/docs Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'sha256-ubKP1QM/6hG5F/i8a7NRS8sCRYEY9XSR20i7TyNoK6k='; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://validator.swagger.io; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# The old Clash of Clans proxy is retired (the backend serves every datum): tabs still running an
	# older version of the app get a clear error, not the page, until they update.
	handle /api/coc/* {
		respond "Gone" 410
	}

	# Application backend (backend/): auth, saved wars, defense bases.
	# Largest request: a base screenshot (10 MB, checked again by the backend) plus its form fields.
	handle /api/v1/* {
		request_body {
			max_size 11MB
		}
		reverse_proxy backend:3001
	}

	# Angular app. Hashed bundles (main-AB12CD34.js, chunk-9LTWR-4v.js: the 8-character hash may
	# contain - and _) never change: cached for a year. Everything else, including index.html served
	# for deep links such as /players and the service worker (ngsw-worker.js, ngsw.json), is
	# revalidated on every visit, so a new deploy is found at once.
	handle {
		root * /srv
		@hashed path_regexp -[0-9a-zA-Z_-]{8}\.(js|css)$
		@other not path_regexp -[0-9a-zA-Z_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"
		# Paths that are not files get index.html (deep links such as /players). Except ngsw.json:
		# missing, it must be a 404, which tells the service worker to remove itself (emergency
		# switch, deploy/service-worker.sh).
		@app {
			not file
			not path /ngsw.json
		}
		rewrite @app /index.html
		file_server
	}
}
