{
  "name": "crociata-nera",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "backend": "npm --prefix backend run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:colors": "node scripts/check-colors.mjs",
    "lint:units": "node scripts/check-units.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "medals": "node scripts/render-medal-stills.mjs",
    "medals:check": "node scripts/render-medal-stills.mjs --check",
    "start:prod": "ng build && node scripts/serve-prod.mjs",
    "e2e:build": "ng build && npm --prefix backend run build",
    "e2e:stack": "node e2e/stack/start-stack.mjs",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:cross": "playwright test --project=firefox --project=webkit",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug --project=chromium",
    "test:e2e:report": "playwright show-report e2e/.artifacts/report",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json && tsc -p e2e/tsconfig.stack.json"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "~22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "~22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "chart.js": "^4.6.1",
    "ng2-charts": "^11.0.0",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.15",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@material-design-icons/svg": "^0.14.15",
    "@playwright/test": "1.65.1",
    "@types/pdfmake": "^0.3.3",
    "@types/three": "^0.187.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
