{
  "name": "crociata-nera",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "server": "node --env-file=.env server/index.mjs",
    "backend": "npm --prefix backend run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "node --test server/server.test.mjs server/history.test.mjs",
    "lint:colors": "node scripts/check-colors.mjs",
    "lint:units": "node scripts/check-units.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "start:prod": "ng build && node scripts/serve-prod.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "~22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "~22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.4",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "chart.js": "^4.6.1",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@material-design-icons/svg": "^0.14.15",
    "@types/three": "^0.187.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
